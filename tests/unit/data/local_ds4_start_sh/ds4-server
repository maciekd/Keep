#!/bin/bash
# The fake ds4-server of tests/unit/test_local_ds4_start_sh.py: records its pid and arguments
# (and, asked for, its GPU keepalive interval) in the files the test names and stays up (or dies at once when DS4_FAKE_EXIT is set).
echo "$$" > "$PID_OUT"
if [ -n "${DS4_FAKE_EXIT:-}" ]; then echo "fatal: no such GPU"; exit 7; fi
[ -n "${KEEPALIVE_OUT:-}" ] && echo "${DS4_METAL_QUEUE_KEEPALIVE_MS:-}" > "$KEEPALIVE_OUT"
# The file appears whole: the harness takes its existence for "the server is up", and bash writes it a line at a time.
printf '%s\n' "$@" > "$ARGS_OUT.part" && /bin/mv "$ARGS_OUT.part" "$ARGS_OUT"
exec /bin/sleep 300    # until the harness kills it: a short life is a deadline for the script under test
